datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  category        String
  experienceLevel String               @default("CINEMATIC") // STANDARD, CINEMATIC, IMMERSIVE_3D
  location        String?
  description     String?
  services        String               @default("")
  targetAudience  String?
  status          String               @default("DRAFT")     // DRAFT, IN_PROGRESS, READY_FOR_REVIEW, COMPLETED, ARCHIVED
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  designConfig    ProjectDesignConfig?
  assets          ProjectAsset[]
  videoJobs       VideoProcessingJob[]

  @@index([category])
  @@index([experienceLevel])
  @@index([status])
}

model ProjectDesignConfig {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Experience Level (synced with Project for quick access)
  experienceLevel     String   @default("CINEMATIC") // STANDARD, CINEMATIC, IMMERSIVE_3D

  // Style Preset
  preset              String   @default("cinematic")

  // Color Tokens
  primaryColor        String   @default("#0f172a")
  secondaryColor      String   @default("#3b82f6")
  accentColor         String   @default("#f59e0b")
  backgroundColor     String   @default("#ffffff")
  surfaceColor        String   @default("#f8fafc")
  textColor           String   @default("#0f172a")
  mutedTextColor      String   @default("#64748b")

  // Typography Tokens
  headingFont         String   @default("Inter")
  bodyFont            String   @default("Inter")
  baseFontSize        String   @default("16px")

  // Layout Preferences
  layoutStyle         String   @default("modern-contained")
  borderRadius        String   @default("0.5rem")
  containerWidth      String   @default("1280px")

  // Animation Preferences
  animationIntensity  String   @default("cinematic")
  enableCanvasFx      Boolean  @default(false)

  // Media Configurations (JSON string)
  mediaPreferences    String   @default("{}")

  // 3D Experience Preferences (JSON string: objectType, scrollInteraction, lightingEnvironment, etc.)
  threeDPreferences   String   @default("{}")

  // Section Configurations (stored as JSON array: [{ id, name, enabled, order, customTitle }])
  sectionsConfigJson  String   @default("[]")

  // Responsive Preferences (stored as JSON)
  responsiveSettings  String   @default("{}")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ProjectAsset {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name            String
  fileName        String
  fileUrl         String
  filePath        String
  mimeType        String
  fileSize        Int
  width           Int?
  height          Int?
  assetType       String   @default("IMAGE") // IMAGE, VIDEO, POSTER, BEFORE_IMAGE, AFTER_IMAGE, MODEL_3D
  assignedSlot    String?  // HERO_BACKGROUND, BEFORE_SLOT, AFTER_SLOT, GALLERY, SECTION_BG, POSTER_FALLBACK
  metadataJson    String   @default("{}")

  videoJobs       VideoProcessingJob[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([assetType])
  @@index([assignedSlot])
}

model VideoProcessingJob {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoAssetId    String
  videoAsset      ProjectAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)

  status          String       @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, CANCELLED
  progress        Float        @default(0.0)      // 0.0 to 100.0
  targetFps       Int          @default(24)       // 12, 24, 30
  maxFrames       Int          @default(60)       // 30, 60, 120, 240
  quality         String       @default("high")   // low, medium, high
  outputFormat    String       @default("webp")   // webp, jpg, png
  frameCount      Int?
  duration        Float?
  width           Int?
  height          Int?
  manifestUrl     String?
  manifestPath    String?
  errorMessage    String?
  metadataJson    String       @default("{}")

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([projectId])
  @@index([videoAssetId])
  @@index([status])
}

